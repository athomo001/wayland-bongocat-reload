# Maintainer: Athan Espinoza <espinozathan@gmail.com>
# PKGBUILD de referencia para wayvpet (spec 0002 M5). El workflow de AUR
# (.github/workflows/aur-publish.yml) genera uno equivalente con la versión y el
# sha256 de cada release.
pkgname=wayvpet
pkgver=0.0.0
pkgrel=1
pkgdesc="Mascota animada sobre Wayland que reacciona al teclado y al ratón"
arch=('x86_64' 'aarch64')
url="https://github.com/athomo001/wayvpet"
license=('MIT')
depends=('wayland' 'libxkbcommon')
makedepends=('rust' 'cargo' 'make' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::https://github.com/athomo001/wayvpet/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  make release
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  make test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  # El Makefile instala binarios, man, temas, presets, .desktop, icono y la
  # unidad systemd de usuario. CHANNEL=arch para el aviso de nueva versión.
  make install DESTDIR="$pkgdir" PREFIX=/usr CHANNEL=arch
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
