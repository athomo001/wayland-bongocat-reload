# ═══════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE BONGO CAT — valores por defecto
# ═══════════════════════════════════════════════════════════════════════════════
# Guarda este fichero en: ~/.config/bongocat/bongocat.conf
# Ejecuta con: bongocat --watch-config
# Cada opción indica su rango y su efecto. Las líneas con "#" están desactivadas.
# ═══════════════════════════════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ APARIENCIA                                                                  │
# └─────────────────────────────────────────────────────────────────────────────┘

# Tamaño y posición del gato.
#   cat_height    : alto del gato en píxeles (10–200).
#   cat_opacity   : opacidad del gato en % (0 = invisible, 100 = opaco).
#   cat_align     : alineación horizontal — left, center o right.
#   cat_x_offset  : desplazamiento horizontal desde la alineación (entero, +/-).
#   cat_y_offset  : desplazamiento vertical desde el centro de la barra (+/-).
cat_height=110
cat_opacity=100
cat_align=center
cat_x_offset=0
cat_y_offset=0

# Tema (skin): nombre de una carpeta en las rutas de temas, o ruta a un
# directorio. Vacío = el gato clásico embebido. Lista: `bongocatctl theme list`.
# Cómo crear/añadir temas: themes/README.md.
# theme=pink

# Obsoleto: sin efecto con el render SVG (el antialiasing siempre está activo).
# enable_antialiasing=1

# Voltear el gato: mirror_x en horizontal, mirror_y en vertical (0 = no, 1 = sí).
mirror_x=0
mirror_y=0

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ BARRA DEL OVERLAY                                                           │
# └─────────────────────────────────────────────────────────────────────────────┘

# Alto de la barra en píxeles (20–300).
overlay_height=120

# Opacidad del fondo de la barra: 0 = transparente, 255 = opaco.
overlay_opacity=0

# Posición en la pantalla: top o bottom.
overlay_position=bottom

# Capa de Wayland: background, bottom, top u overlay (overlay = siempre visible).
layer=top

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ DISPOSITIVOS DE ENTRADA                                                     │
# └─────────────────────────────────────────────────────────────────────────────┘

# Encuentra tu dispositivo con: bongocat-find-devices
# Repite la línea para monitorear varios teclados.
# La ruta debe empezar por /dev/input/ (validado por seguridad).
keyboard_device=/dev/input/event4

# Ratón: con enable_mouse=1 el gato da golpecitos al mover / clicar / girar la
# rueda del ratón físico (privacidad: no se lee la posición, solo "hay actividad").
#   mouse_paw           : qué pata usa el ratón — left, right o random.
#   mouse_move_interval : ms entre golpecitos mientras mueves el ratón (10–2000).
#   mouse_device        : ruta /dev/input/… (repetible). Vacío = autodetección.
enable_mouse=1
mouse_paw=right
mouse_move_interval=50

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ MULTI-MONITOR (opcional)                                                    │
# └─────────────────────────────────────────────────────────────────────────────┘

# Déjalo comentado para auto-detectar.
# Nombres de monitor: wlr-randr  o  hyprctl monitors
# monitor=eDP-1
# monitor=eDP-1,HDMI-A-1

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ ANIMACIÓN                                                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# fps               : fotogramas por segundo (1–120).
# idle_frame        : fotograma que se muestra en reposo (0–4).
# keypress_duration : ms que se mantiene la pata bajada tras una pulsación (10–5000).
# happy_kpm         : teclas/minuto a partir de las cuales un tema de sprite sheet
#                     con estado "happy" lo muestra (0–10000; 0 = desactivado).
#                     Solo cuenta eventos de teclado, sin registrar qué tecla.
fps=60
idle_frame=0
happy_kpm=0
keypress_duration=100

# Mapeo de manos: 0 = pata al azar; 1 = teclas de la izquierda → pata izquierda,
# teclas de la derecha → pata derecha.
enable_hand_mapping=1

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ MODO REPOSO (opcional)                                                      │
# └─────────────────────────────────────────────────────────────────────────────┘

# Dormir tras N segundos sin actividad de teclado (0 = desactivado).
# Al activarse se muestra un fotograma de gato dormido.
idle_sleep_timeout=0

# Reposo por horario (necesita enable_scheduled_sleep=1). Rango que cruza la
# medianoche permitido (p. ej. 22:00 → 06:00).
enable_scheduled_sleep=0
sleep_begin=22:00
sleep_end=06:00

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ PANTALLA COMPLETA                                                           │
# └─────────────────────────────────────────────────────────────────────────────┘

# Mantener el overlay visible aunque se detecte una ventana a pantalla completa.
# 0 = ocultar (por defecto), 1 = seguir mostrando.
# disable_fullscreen_hide=0

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ HOTPLUG                                                                     │
# └─────────────────────────────────────────────────────────────────────────────┘

# Cada cuántos segundos rescanear en busca de dispositivos nuevos
# (0 = escanear solo una vez al arrancar).
# hotplug_scan_interval=30

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ ANIMACIÓN DE PRUEBA                                                         │
# └─────────────────────────────────────────────────────────────────────────────┘

# Duración de cada fotograma de la animación de prueba, en ms.
# test_animation_duration=200
# Intervalo entre ciclos de la animación de prueba, en ms (0 = desactivado).
# test_animation_interval=0

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ CONTROL (IPC)                                                               │
# └─────────────────────────────────────────────────────────────────────────────┘

# Socket Unix de control en $XDG_RUNTIME_DIR/bongocat[-MONITOR].sock, para que
# `bongocatctl ping/state/stop` (y el icono de bandeja) hablen con la instancia.
# Solo lo atiende tu propio usuario (modo 0600 + SO_PEERCRED). 1 = activo.
enable_ipc=1

# Icono en la bandeja del sistema (menú: mostrar/ocultar, reiniciar overlay,
# recargar config, configurar, elegir tema, cerrar). 1 = activo; `--no-tray` lo
# desactiva para una ejecución. Si el escritorio no tiene host SNI, no molesta.
enable_tray=1

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ DEPURACIÓN                                                                  │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# ⚠️ AVISO DE PRIVACIDAD: en la versión actual, enable_debug=1 registra las
#    pulsaciones de teclado (keycodes) en stdout/stderr. Mantén 0 salvo para
#    diagnóstico puntual. Este volcado está en camino de eliminarse: la tecla
#    se reducirá a izquierda/derecha y bongocat no podrá saber cuál pulsaste.
#
enable_debug=0
