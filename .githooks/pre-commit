#!/usr/bin/env bash
# Hook de pre-commit del proyecto. Activar una vez con:
#   git config core.hooksPath .githooks
#
# Comprueba **solo los ficheros que están en el índice** (no todo el árbol):
#  - formato Rust (rustfmt --check) de los .rs staged;
#  - formato C (clang-format) de los .c/.h staged (árbol C histórico);
#  - comentarios en inglés residuales (aviso, no bloquea).
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Ficheros de código en el índice.
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR -- '*.c' '*.h' '*.rs' 2>/dev/null || true)
[ "${#staged[@]}" -eq 0 ] && exit 0

fail=0

# Formato Rust: solo sobre los .rs realmente en el índice, no todo el árbol. Así
# una WIP sin formatear en otro fichero (p. ej. de otra rama) no bloquea un
# commit que no la toca.
mapfile -t staged_rs < <(printf '%s\n' "${staged[@]}" | grep -E '\.rs$' || true)
if [ "${#staged_rs[@]}" -gt 0 ] && command -v rustfmt >/dev/null 2>&1; then
  rustfmt --edition 2021 --check "${staged_rs[@]}" \
    || { echo "pre-commit: 'cargo fmt' pendiente en ficheros del índice"; fail=1; }
fi

mapfile -t staged_c < <(printf '%s\n' "${staged[@]}" | grep -E '\.[ch]$' || true)
if [ "${#staged_c[@]}" -gt 0 ] && command -v clang-format >/dev/null 2>&1; then
  clang-format --dry-run --Werror "${staged_c[@]}" \
    || { echo "pre-commit: 'clang-format' pendiente (árbol C histórico)"; fail=1; }
fi

# Aviso de comentarios en inglés (no bloquea el commit).
if [ -x scripts/check_comment_lang.sh ]; then
  scripts/check_comment_lang.sh "${staged[@]}" || \
    echo "pre-commit: aviso — revisa los comentarios de arriba (posible inglés)"
fi

exit $fail
